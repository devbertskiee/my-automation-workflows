    {
      "parameters": {
        "jsCode": "const currentStep = $input.first().json.currentStep\nconst now = new Date();\n\nlet nextStep, nextEmailAt, status;\n\nswitch (currentStep) {\n  case 'Email 1':\n    nextStep = 'Email 2';\n    nextEmailAt = new Date(now.getTime() + 24 * 60 * 60 * 1000);\n    status = 'Active';\n    break;\n  case 'Email 2':\n    nextStep = 'Email 3';\n    nextEmailAt = new Date(now.getTime() + 48 * 60 * 60 * 1000);\n    status = 'Active';\n    break;\n  case 'Email 3':\n    nextStep = 'Email 4';\n    nextEmailAt = new Date(now.getTime() + 96 * 60 * 60 * 1000);\n    status = 'Active';\n    break;\n  case 'Email 4':\n    nextStep = 'Done';\n    nextEmailAt = null;\n    status = 'Cold'; // No reply after full sequence\n    break;\n  default:\n    nextStep = 'Done';\n    nextEmailAt = null;\n    status = 'Active';\n}\n\nreturn {\n  recordId: $input.first().json.recordId,\n  emailsSent: $input.first().json.emailsSent,\n  lastEmailSent: now.toISOString(),\n  nextStep: nextStep,\n  nextEmailAt: nextEmailAt ? nextEmailAt.toISOString().split('T')[0] : null,\n  status: status\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
