      "name": "Slack — Post Digest"
    },
    {
      "parameters": {
        "jsCode": "// Filter out empty items from \"Always Output Data\" (Airtable nodes that returned 0 records)\nconst hasData = d => d.json && d.json.id;\n\n// Fetch data from all 4 Airtable queries\nconst pipeline = $(\"Airtable — Active Pipeline\").all().filter(hasData);\nconst newLeads = $(\"Airtable — New Leads Yesterday\").all().filter(hasData);\nconst replies = $(\"Airtable — Replies Yesterday\").all().filter(hasData);\nconst coldLeads = $(\"Airtable — Going Cold\").all().filter(hasData);\n\n// Compute pipeline breakdown\nconst totalPipeline = pipeline.length;\nconst hotCount = pipeline.filter(l => (l.json.fields?.Sequence || l.json.Sequence) === \"Hot\").length;\nconst nurtureCount = pipeline.filter(l => (l.json.fields?.Sequence || l.json.Sequence) === \"Nurture\").length;\n\n// Format today's date header\nconst today = new Date().toLocaleDateString('en-US', {\n  weekday: 'short', month: 'short', day: 'numeric'\n});\n\n// Check if ALL sections are empty (including pipeline)\nif (pipeline.length === 0 && newLeads.length === 0 && replies.length === 0 && coldLeads.length === 0) {\n  return [{\n    text: JSON.stringify(`📊 Daily Pipeline Digest — ${today} — Nothing to report. All quiet. ✅`),\n    digestType: \"empty\"\n  }];\n}\n\n// Build the digest message\nlet text = `📊 Daily Pipeline Digest — ${today}\\n\\n`;\ntext += `Active leads in pipeline: ${totalPipeline} (🔥 ${hotCount} Hot · 🌱 ${nurtureCount} Nurture)`;\ntext += '\\n\\n';\n\n// New leads section\ntext += `New leads yesterday: ${newLeads.length}`;\nif (newLeads.length > 0) {\n  newLeads.forEach(l => {\n    const name = l.json.fields?.Name || l.json.Name || 'Unknown';\n    const score = l.json.fields?.Score !== undefined ? `${l.json.fields.Score}/10` : l.json.Score !== undefined ? `${l.json.Score}/10` : 'N/A';\n    const seq = l.json.fields?.Sequence || l.json.Sequence || 'N/A';\n    text += `\\n  • ${name} — Score: ${score} — ${seq}`;\n  });\n}\ntext += '\\n\\n';\n\n// Replies section\ntext += `Replies yesterday: ${replies.length}`;\nif (replies.length > 0) {\n  replies.forEach(l => {\n    const name = l.json.fields?.Name || l.json.Name || 'Unknown';\n    text += `\\n  • ${name} — needs follow-up`;\n  });\n}\ntext += '\\n\\n';\n\n// Going cold section\ntext += `Leads going cold: ${coldLeads.length}`;\nif (coldLeads.length > 0) {\n  coldLeads.forEach(l => {\n    const name = l.json.fields?.Name || l.json.Name || 'Unknown';\n    text += `\\n  • ${name} — no reply after 4 emails`;\n  });\n}\n\nreturn [{ text: JSON.stringify(text), digestType: \"digest\" }];"
      },
